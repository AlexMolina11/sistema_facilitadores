APP_NAME="Facilitadores FEPADE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/El_Salvador

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================================
# BASE DE DATOS LOCAL
# ==========================================================
# Cada desarrollador debe utilizar una base de datos propia.
# Nunca colocar aquí las credenciales del servidor productivo.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fepade_facilitadores_local
DB_USERNAME=root
DB_PASSWORD=

# ==========================================================
# SESIONES, CACHE Y COLAS
# ==========================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=database

# ==========================================================
# ARCHIVOS
# ==========================================================
FILESYSTEM_DISK=public

# ==========================================================
# CORREO LOCAL
# ==========================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="facilitadores@fepade.org.sv"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================
# REDIS
# ==========================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================================
# AWS
# ==========================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================================
# VITE
# ==========================================================
VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------
# Integración SAF
# ------------------------------------------------------------

SAF_ENABLED=false
SAF_MODE=database
SAF_SOURCE=SAF

# ID de la entidad FEPADE proporcionado por SAF
SAF_ENTITY_ID=

# Procesamiento
SAF_CHUNK_SIZE=100
SAF_MAX_RECORDS=0
SAF_CONTINUE_ON_ERROR=true
SAF_MAX_ERRORS=0

# Consultores
SAF_CONSULTANTS_CREATE=true
SAF_CONSULTANTS_UPDATE=true
SAF_CONSULTANTS_DEACTIVATE_MISSING=false
SAF_CONSULTANTS_EXTERNAL_KEY=id_instructor

# Capacitaciones
SAF_TRAININGS_CREATE=true
SAF_TRAININGS_UPDATE=true
SAF_TRAININGS_DEACTIVATE_MISSING=false
SAF_TRAININGS_EXTERNAL_KEY=codigo_evento_externo

# Comparación de datos
SAF_HASH_ENABLED=true
SAF_HASH_ALGORITHM=sha256

# Auditoría
SAF_AUDIT_ENABLED=true
SAF_STORE_ERROR_PAYLOAD=true
SAF_STORE_EXCEPTION_DETAILS=true

# Ejecución automática
SAF_SCHEDULE_ENABLED=false
SAF_SCHEDULE_TIME=02:00
SAF_SCHEDULE_TIMEZONE=America/El_Salvador

# Prevención de ejecuciones simultáneas
SAF_LOCK_ENABLED=true
SAF_LOCK_SECONDS=3600