APP_NAME="Facilitadores FEPADE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/El_Salvador

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================================
# BASE DE DATOS LOCAL
# ==========================================================
# Cada desarrollador debe utilizar una base de datos propia.
# Nunca colocar aquí las credenciales del servidor productivo.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fepade_facilitadores_local
DB_USERNAME=root
DB_PASSWORD=

# ==========================================================
# SESIONES, CACHE Y COLAS
# ==========================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=database

# ==========================================================
# ARCHIVOS
# ==========================================================
FILESYSTEM_DISK=public

# ==========================================================
# CORREO LOCAL
# ==========================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="facilitadores@fepade.org.sv"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================
# REDIS
# ==========================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================================
# AWS
# ==========================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================================
# VITE
# ==========================================================
VITE_APP_NAME="${APP_NAME}"

# ==========================================================
# INTEGRACIÓN SAF
# ==========================================================
# Estas variables describen el origen de datos.
# Laravel no se conectará directamente a SQL Server.
SAF_INTEGRACION_HABILITADA=false
SAF_ORIGEN_NOMBRE="SAF"
SAF_ORIGEN_TIPO="SQLServer"